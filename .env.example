DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=damol_digital
DB_USER=damol_digital
DB_PASSWORD=damol_digital
DB_HOST=localhost
DB_PORT=5432

# En Neon: DATABASE_URL reemplaza a las 5 variables DB_* de arriba (ver settings.py, usa una u
# otra). Formato: postgresql://usuario:password@host/dbname?sslmode=require
# DATABASE_URL=

# Cloudinary: una sola variable con todo (cloud name, api key, api secret), tal como la muestra
# su dashboard en "API Environment variable". Sin esto el proyecto no arranca.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
